# Surokkha environment variables
# This file is a TEMPLATE: it has names only and is safe to commit.
# Copy it to ".env" and fill in your real values there.
# NEVER commit ".env" and never paste real keys into chats, screenshots or the repo.

# --- Hugging Face (for SAM 3.1 checkpoints) ---
# Create a Read token at: Hugging Face -> Settings -> Access Tokens
HF_TOKEN=

# --- Baseten (Muse Spark Open) ---
# Key and endpoint details arrive in the email from Baseten if your request is approved
BASETEN_API_KEY=
BASETEN_BASE_URL=
BASETEN_MODEL=meta-models/muse-spark-open-1026

# --- Fireworks (optional fallback) ---
# Details arrive by email if your team is selected
FIREWORKS_API_KEY=
FIREWORKS_BASE_URL=
FIREWORKS_MODEL=

# --- Modal (GPU for the SAM 3.1 worker) ---
# Created with: modal token new  (stored by the Modal CLI; fill only if you need them in code)
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# --- Which reasoning provider to use: baseten or fireworks ---
LLM_PROVIDER=baseten

# --- App settings ---
DATABASE_URL=sqlite:///./surokkha.db
UPLOAD_DIR=./data/uploads
UPLOAD_MAX_MB=100
ALLOWED_ORIGINS=http://localhost:5173

# --- Pipeline settings ---
FRAME_RATE_FPS=1
MAX_FRAMES_PER_VIDEO=60
# Required PPE for the missing-PPE check (default: face mask)
REQUIRED_PPE=face mask
